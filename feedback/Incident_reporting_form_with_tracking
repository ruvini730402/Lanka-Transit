<?php
// Connect to database
$host = 'localhost';
$user = 'root';
$pass = '';
$db = 'lankatrasit';

$conn = new mysqli($host, $user, $pass, $db);
if ($conn->connect_error) {
    die("Database connection failed.");
}

// Fetch incidents from DB
$incidentRows = [];
$sql = "SELECT tracking_id, incident_datetime, incident_type, bus_number, route, location, status, attachment FROM incidents ORDER BY id DESC";
$result = $conn->query($sql);
if ($result && $result->num_rows > 0) {
    while ($row = $result->fetch_assoc()) {
        $incidentRows[] = $row;
    }
}
?>
