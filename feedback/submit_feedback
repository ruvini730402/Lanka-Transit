<?php
// Only handle POST requests
if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    echo "<script>alert('Access Denied'); window.location.href='Incident_reporting_form_with_tracking.php';</script>";
    exit();
}

// DB connection
$host = 'localhost';
$user = 'root';
$pass = '';
$db   = 'lankatrasit'; // Make sure this DB exists
$conn = new mysqli($host, $user, $pass, $db);

if ($conn->connect_error) {
    die("❌ Connection failed: " . $conn->connect_error);
}

// Sanitize function
function clean($input) {
    return htmlspecialchars(trim($input), ENT_QUOTES, 'UTF-8');
}

// Form inputs
$name        = clean($_POST['user_name'] ?? 'Anonymous');
$type        = clean($_POST['incident_type'] ?? '');
$datetime    = $_POST['incident_datetime'] ?? '';
$location    = clean($_POST['incident_location'] ?? '');
$bus_number  = clean($_POST['bus_number'] ?? '');
$route       = clean($_POST['route'] ?? '');
$description = clean($_POST['description'] ?? '');

// Validate
if (!$type || !$datetime || !$location || !$bus_number || !$route || !$description) {
    echo "<script>alert('⚠️ All required fields must be filled.'); window.history.back();</script>";
    exit();
}

// Generate Tracking ID
$result = $conn->query("SELECT MAX(id) AS last_id FROM incidents");
$lastId = ($result && $row = $result->fetch_assoc()) ? intval($row['last_id']) + 1 : 1;
$tracking_id = "INC-" . str_pad($lastId, 4, '0', STR_PAD_LEFT);

// Handle file upload
$attachmentPath = '';
if (!empty($_FILES['attachment']['name'])) {
    $allowedTypes = ['jpg', 'jpeg', 'png', 'pdf'];
    $fileTmp  = $_FILES['attachment']['tmp_name'];
    $fileName = basename($_FILES['attachment']['name']);
    $ext = strtolower(pathinfo($fileName, PATHINFO_EXTENSION));

    if (in_array($ext, $allowedTypes)) {
        $uploadDir = 'uploads/';
        if (!is_dir($uploadDir)) {
            mkdir($uploadDir, 0755, true);
        }

        $newName = uniqid('file_') . "." . $ext;
        $targetPath = $uploadDir . $newName;

        if (move_uploaded_file($fileTmp, $targetPath)) {
            $attachmentPath = $targetPath; // Save relative path
        } else {
            echo "<script>alert('❌ Failed to upload file.'); window.history.back();</script>";
            exit();
        }
    } else {
        echo "<script>alert('❌ Invalid file type.'); window.history.back();</script>";
        exit();
    }
}

// Insert into DB
$stmt = $conn->prepare("INSERT INTO incidents (
    tracking_id, user_name, incident_type, incident_datetime,
    location, bus_number, route, description, attachment, status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'Submitted')");

$stmt->bind_param(
    "sssssssss",
    $tracking_id, $name, $type, $datetime, $location,
    $bus_number, $route, $description, $attachmentPath
);

if ($stmt->execute()) {
    echo "<script>alert('✅ Incident submitted! Your tracking ID is: $tracking_id'); window.location.href='Incident_reporting_form_with_tracking.php';</script>";
} else {
    echo "<script>alert('❌ Failed to submit incident.'); window.history.back();</script>";
}

$stmt->close();
$conn->close();
?>
