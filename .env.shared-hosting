# Lanka Transit - Shared Hosting Environment Configuration
# Replace these values with your hosting provider's database credentials

# =============================================================================
# SHARED HOSTING DATABASE CONFIGURATION
# =============================================================================
# Most shared hosting providers use:
# - DB_HOST=localhost (or IP address like 127.0.0.1)
# - Database name with your account prefix
# - Username with your account prefix
# - Password provided by hosting control panel

DB_HOST=localhost
DB_NAME=your_account_prefix_lankatransit
DB_USERNAME=your_account_prefix_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4
DB_PORT=3306

